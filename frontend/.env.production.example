# Ví dụ cấu hình build production cho frontend.
# Sao chép thành .env.production rồi điền giá trị — file .env.production KHÔNG được commit.
#
# CẢNH BÁO: mọi biến tiền tố VITE_ đều được Vite nướng thẳng vào bundle gửi tới trình duyệt.
# Tức là chúng CÔNG KHAI 100% khi app chạy. Tuyệt đối không đặt khoá API, mật khẩu hay token vào đây.
# Khoá thật chỉ nằm ở backend/.env (không bao giờ commit).

# Rỗng = dùng cùng origin, để nginx reverse-proxy /api (khuyến nghị cho production).
VITE_API_BASE=

# Ví dụ khi backend ở domain khác:
# VITE_API_BASE=https://api.example.vn

# ── ĐIỂM CẤU HÌNH DUY NHẤT CHO DOMAIN ────────────────────────────────────────
# Origin của site, KHÔNG có dấu / cuối. Đây là nơi duy nhất cần sửa khi chuyển
# domain: mọi link dùng nó đều lấy từ đây (xem src/lib/siteLinks.ts), nên đổi
# staging → production chỉ là đổi dòng này, không phải sửa code.
#
#   Staging:     domain thử nghiệm, dùng để kiểm tra bản build.
#   Production:  tên miền chính thức, mua một lần rồi đổi giá trị ở đây.
#
# Để TRỐNG khi chưa mua tên miền. Khi trống, các link phụ thuộc domain sẽ rơi
# về '#' (không trỏ đi đâu) thay vì đoán tên miền — đặc biệt là link GEO ở
# trang /method.
VITE_SITE_URL=

# Ví dụ:
# staging    VITE_SITE_URL=https://<ten-mien-staging>
# production VITE_SITE_URL=https://<ten-mien-chinh-thuc>

# ── CỘNG ĐỒNG DISCORD ────────────────────────────────────────────────────────
# Link mời vào server Discord, dùng cho nút góc phải mọi trang (src/lib/siteLinks.ts
# là nơi duy nhất đọc biến này). Để TRỐNG khi chưa có server: nút sẽ ẩn hẳn thay
# vì hiện ra một nút bấm không đi đâu. Đây là link công khai, đừng dùng token bot.
VITE_DISCORD_INVITE_URL=

# Ví dụ:
#   VITE_DISCORD_INVITE_URL=https://discord.gg/<ma-moi>
