# ── /opt/novafilm 专用 Postgres + Redis（勿与其它项目共用）────────
POSTGRES_USER=novafilm
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=novafilm
POSTGRES_PORT=15432
REDIS_PORT=16379

# 上线环境：SECRET_KEY 若仍是下面的占位符，进程会直接启动失败
APP_ENV=production
# 必填：python -c "import secrets; print(secrets.token_urlsafe(48))"，勿沿用占位符
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://novafilm:change-me-strong-db-password@127.0.0.1:15432/novafilm
DATABASE_URL_SYNC=postgresql+psycopg2://novafilm:change-me-strong-db-password@127.0.0.1:15432/novafilm
# API 连接池（uvicorn 建议 --workers 1）；Worker unit 设 NOVA_DB_ROLE=celery
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_SIZE_CELERY=2
DB_MAX_OVERFLOW_CELERY=3
REDIS_URL=redis://127.0.0.1:16379/0

# 本站对外域名。前端是 Firebase Hosting 上的静态站，API 是这台 VPS:
#   PUBLIC_BASE_URL  邮件里的链接、媒体 URL 的前缀
#   CORS_ORIGINS     允许调用 API 的 origin，逗号分隔、带 scheme、不带结尾 /
# 写错这里的表现是「浏览器报 CORS，curl 却正常」，所以别偷懒先填 IP。
PUBLIC_BASE_URL=https://novastudio.rr.kg
CORS_ORIGINS=https://novastudio.rr.kg,https://admin.novastudio.rr.kg,https://api.novastudio.rr.kg
# OSS 桶 CORS 追加的站点 origin（逗号分隔 http(s)://host[:port]）。留空则只有回环地址。
# 格式非法启动即报错并点名变量，不会静默忽略。
OSS_CORS_EXTRA_ORIGINS=https://novastudio.rr.kg,https://admin.novastudio.rr.kg
# 视为本地 /static 的站点 host（逗号分隔 host[:port]，不带 scheme）。
STATIC_HOST_ALLOWLIST=api.novastudio.rr.kg
# 真实生产密钥见 VPS 上的 backend/.env（勿提交）

# ── 第三方登录 ─────────────────────────────────────────────────────────────
# callback 一律是 https://api.novastudio.rr.kg/api/auth/<provider>/callback，
# 必须与 provider 控制台里登记的地址逐字节相同（末尾不加 /，不加 query）。
# 在控制台里改地址后不必重启：回调是每次请求现算的。
# 上线前务必访问 https://api.novastudio.rr.kg/api/auth/providers 自查：
# 返回的数组里应只出现你真正配好的 provider。
OAUTH_REDIRECT_BASE_URL=https://api.novastudio.rr.kg
# 登录后回前端的落点。?next= 只接受相对路径，或 origin 在本变量/CORS_ORIGINS 里的绝对 URL。
OAUTH_POST_LOGIN_REDIRECT_URL=https://novastudio.rr.kg/auth
# true = provider 已验证的邮箱自动挂到同名本地账号；false = 老用户先用密码登录再手动绑
OAUTH_AUTO_LINK_EMAIL=true
# 每 IP 每分钟允许的 /api/auth/* 请求数
OAUTH_RATE_LIMIT_PER_MINUTE=30
# Google Cloud Console → Credentials → OAuth client ID (Web)
# GOOGLE_CLIENT_ID=your-app.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# Microsoft Entra → App registrations → Web platform
# MICROSOFT_CLIENT_ID=your-application-client-id
# MICROSOFT_CLIENT_SECRET=replace-me
# Meta for Developers → Facebook Login → Settings（须开 Use App Authentication，且 App 处于 Live）
# FACEBOOK_CLIENT_ID=replace-me
# FACEBOOK_CLIENT_SECRET=replace-me
# TikTok for Developers → Login Kit for Web。变量名用 client key 是刻意的。
#   Redirect URL 必须 https、无 query/fragment、短于 512 字符，backend 启动即校验。
#   TikTok 不返回邮箱：首次登录建的是「待完善」账号，需 POST /api/auth/oauth/setup 补邮箱密码。
# TIKTOK_CLIENT_KEY=replace-me
# TIKTOK_CLIENT_SECRET=replace-me

ARK_MOCK=false
# 开源版统一走 TokenFree New API（管理后台填写 Key；勿填 Moonshot/方舟 Key）
ARK_API_KEY=your-tokenfree-api-key

OPENAI_API_KEY=your-tokenfree-api-key
OPENAI_BASE_URL=https://www.tokenfree.com/v1
MODEL_LLM=kimi-k2.6

USE_CELERY=true
QUOTA_ENABLED=false

BILLING_ENABLED=true
BILLING_MARKUP=1.0
BILLING_SIGNUP_GRANT_FEN=500
EPAY_API_URL=https://pay.gitcc.com
EPAY_PID=
EPAY_KEY=
# 勿用含 /api/ 的 notify（pay.gitcc.com WAF 会拦）；nginx 将 /epay/notify 反代到后端
EPAY_NOTIFY_URL=https://api.novastudio.rr.kg/epay/notify
EPAY_RETURN_URL=https://novastudio.rr.kg/pricing?paid=1

CELERY_AUTOSCALE_MIN=1
CELERY_AUTOSCALE_MAX=3
CELERY_WORKER_QUEUES=drama,oss,video,pipeline
