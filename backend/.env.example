# Môi trường: development (mặc định, để trống = chạy trên máy) / production (khi lên mây).
# Khi APP_ENV=production mà SECRET_KEY còn là giá trị mẫu bên dưới, tiến trình sẽ từ chối khởi động.
APP_ENV=
# Bắt buộc khi lên production, dùng giá trị ngẫu nhiên để ghi đè:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Giá trị này dùng cho cả việc ký JWT đăng nhập và mã hoá các API Key lưu trong database.
# Tuyệt đối không dùng lại giá trị mẫu.
SECRET_KEY=dev-secret-change-me
# Tên ứng dụng: tiêu đề /docs, phản hồi health check, và tiền tố email cảnh báo đều lấy từ đây.
APP_NAME=NOVAFILM
# Bật DEBUG=true để log ứng dụng chi tiết hơn; SQL_ECHO=true mới in SQL gốc (mặc định tắt để khỏi lấn át màn hình).
# DEBUG=true
# SQL_ECHO=false
# Chỉ hỗ trợ PostgreSQL (cấu hình Docker xem deploy/docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
DATABASE_URL_SYNC=postgresql+psycopg2://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
# Gợi ý cho PostgreSQL khi lên production: API chạy `uvicorn --workers 1`; Celery đặt PRINTFILM_DB_ROLE=celery
# Nên căn số kết nối theo độ song song của tác vụ (môi trường thật: 100+20, PG max_connections ≥ 250)
# DB_POOL_SIZE=100
# DB_MAX_OVERFLOW=20
# DB_POOL_SIZE_CELERY=2
# DB_MAX_OVERFLOW_CELERY=3
REDIS_URL=redis://127.0.0.1:16379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Thêm origin của website vào luật CORS của bucket OSS (phân tách bằng dấu phẩy, định dạng http(s)://host[:port]).
# Để trống = chỉ cho phép địa chỉ loopback của máy (đã tích hợp sẵn, không cần cấu hình).
# Sai định dạng sẽ báo lỗi ngay lúc khởi động và nêu đích danh biến đó.
# OSS_CORS_EXTRA_ORIGINS=https://your-site.example.com,https://admin.your-site.example.com
# Thêm tên miền vào danh sách host cho phép của trang `/static` cục bộ (phân tách bằng dấu phẩy, không kèm scheme).
# Để trống = chỉ cho phép 127.0.0.1:8000 / localhost:8000 (đã tích hợp sẵn). Sai định dạng cũng báo lỗi lúc khởi động.
# STATIC_HOST_ALLOWLIST=your-site.example.com
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Khi khởi động, nâng quyền các tài khoản đã có lên admin (phân tách bằng dấu phẩy, không tạo tài khoản mới).
# ADMIN_BOOTSTRAP_EMAILS=admin@example.com

# ── Đăng nhập bên thứ ba (Authorization Code + PKCE) ─────────────────────────
# client_secret CHỈ nằm ở backend. Trình duyệt đi tới
# /api/auth/{provider}/login, backend đổi code lấy token rồi trả về một mã dùng
# một lần — không có JWT nào nằm trong URL.
#
# Chỉ provider nào có ĐỦ client_id và client_secret mới xuất hiện ở
# GET /api/auth/providers; để trống = tắt nút. Đừng mở feature flag ở frontend:
# hai nơi bật nút sẽ lệch nhau và người dùng bấm mới biết.
#
# URL callback luôn dựng từ OAUTH_REDIRECT_BASE_URL + /api/auth/<provider>/callback.
# Nó phải khớp TỪNG BYTE với giá trị đăng ký trong console của provider — không
# dùng http://127.0.0.1 thay cho http://localhost, không thêm query, không thêm /
# ở cuối, không bỏ https.
#   OAUTH_REDIRECT_BASE_URL=https://api.example.com
#     -> https://api.example.com/api/auth/google/callback
#     -> https://api.example.com/api/auth/microsoft/callback
#     -> https://api.example.com/api/auth/facebook/callback
#     -> https://api.example.com/api/auth/tiktok/callback
#
# Callback phải nằm ở backend (cổng API), không nằm ở trang tĩnh trên Firebase:
# client_secret không được đi vào trình duyệt.
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
#   Authorized redirect URIs: đúng URL ở trên.
# MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET
#   Microsoft Entra → App registrations → "Single tenant" hoặc "Accounts in any
#   organizational directory" để dùng được cả tài khoản cá nhân.
#   Web → Redirect URI (Mobile and desktop applications) chính là URL trên.
# FACEBOOK_CLIENT_ID / FACEBOOK_CLIENT_SECRET
#   Meta for Developers → app của bạn → Facebook Login → Settings.
#   "Valid OAuth Redirect URIs" nhập URL trên. Chọn "Use App Authentication"
#   để lấy Client Secret. App phải ở chế độ Live, app ở Development chỉ nhận
#   tài khoản quản trị viên.
# TIKTOK_CLIENT_KEY / TIKTOK_CLIENT_SECRET
#   TikTok for Developers → app → Login Kit for Web. Biến môi trường cố tình
#   đặt tên "client key" vì đó là tên TikTok dùng, đừng nhầm sang GOOGLE_CLIENT_ID.
#   Redirect URL phải là https, tĩnh (không query, không fragment) và ngắn hơn
#   512 ký tự — backend kiểm tra ngay lúc khởi động và báo lỗi nếu sai.
#   TikTok KHÔNG trả email: lần đăng nhập đầu sẽ tạo tài khoản chưa hoàn chỉnh,
#   người dùng phải tự đặt email + mật khẩu (POST /api/auth/oauth/setup).
#
# OAUTH_REDIRECT_BASE_URL=https://api.example.com
# Trang frontend đón sau khi đăng nhập xong (đọc mã một lần rồi gọi
# POST /api/auth/oauth/exchange). Tham số ?next= chỉ nhận đường dẫn tương đối,
# hoặc URL tuyệt đối thuộc origin nằm trong chính biến này hoặc CORS_ORIGINS.
# OAUTH_POST_LOGIN_REDIRECT_URL=https://novastudio.rr.kg/auth
# Địa chỉ provider đã xác minh có được tự gắn vào tài khoản cục bộ sẵn có không.
# false = người dùng cũ phải đăng nhập bằng mật khẩu trước rồi tự liên kết.
# OAUTH_AUTO_LINK_EMAIL=true
# Số request mỗi phút mỗi IP trên toàn bộ /api/auth/* (bắt đầu, callback,
# đổi mã, bổ sung thông tin). /api/auth/providers cố tình không bị giới hạn.
# OAUTH_RATE_LIMIT_PER_MINUTE=30
# GOOGLE_CLIENT_ID=your-app.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# MICROSOFT_CLIENT_ID=your-application-client-id
# MICROSOFT_CLIENT_SECRET=replace-me
# FACEBOOK_CLIENT_ID=replace-me
# FACEBOOK_CLIENT_SECRET=replace-me
# TIKTOK_CLIENT_KEY=replace-me
# TIKTOK_CLIENT_SECRET=replace-me

ARK_MOCK=false
# Bản mã nguồn mở dùng TokenFree New API (https://www.tokenfree.com/v1).
# Hãy nhập API Key ở trang quản trị「Hệ thống → Mô hình」rồi kéo và chọn model;
# dòng dưới đây chỉ dùng cho lần nạp đầu tiên.
# Endpoint này là chuẩn OpenAI-compatible, nên cũng dùng được với:
#   Gemini  : https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenAI  : https://api.openai.com/v1
# Chọn model id từ danh sách mà khoá thật trả về, đừng chọn theo trí nhớ:
#   GET <OPENAI_BASE_URL>/models   (với header Authorization: Bearer <khoá>)
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://www.tokenfree.com/v1
MODEL_LLM=

USE_CELERY=false
QUOTA_ENABLED=false

# Tính tiền theo token (giá người dùng = chi phí chính thức, không cộng thêm)
BILLING_ENABLED=false
BILLING_MARKUP=1.0
# TokenFree / New API: 500000 quota = 1 USD, quy đổi ra phân (đơn vị nhỏ nhất) theo tỷ giá này
BILLING_USD_CNY=7.0
BILLING_SIGNUP_GRANT_FEN=500
# Cổng thanh toán pay.gitcc.com (khóa không được commit)
EPAY_API_URL=https://pay.gitcc.com
EPAY_PID=
EPAY_KEY=
# Khi lên production, URL notify không chứa /api/ (WAF của pay.gitcc.com chặn);
# nginx trên mây đảo /epay/notify → /api/billing/epay/notify
# EPAY_NOTIFY_URL=https://your-site.example.com/epay/notify
# EPAY_RETURN_URL=https://your-site.example.com/pricing?paid=1
# Cấu hình OSS / EPAY / tên miền thật nằm ở backend/.env.secrets.local trên máy (không commit)

# Model hàng đầu (cần mở trong console Ark; nếu tài khoản chỉ hỗ trợ điểm truy cập thì đổi thành ep-xxxxxxxx)
# Model văn bản xem ở OPENAI_* / MODEL_LLM phía trên; các dòng dưới là Seedream / Seedance / TTS
MODEL_IMAGE=doubao-seedream-5-0-260128
# Điểm truy cập Seedream 4.5 (tuỳ chọn; chưa điền thì dùng MODEL_IMAGE)
# MODEL_IMAGE_45=ep-xxxxxxxx
MODEL_VIDEO=doubao-seedance-2-5-260628
# Điểm truy cập Seedance 2.0 (tuỳ chọn; khi có cùng lúc với 2.5 thì giao diện hiện thêm seedance-2)
# MODEL_VIDEO_2=doubao-seedance-2-0-260128
SEEDANCE_DURATION_MIN=4
SEEDANCE_DURATION_MAX=30
# Video Seedance ở chế độ khoa học vẫn có âm thanh: chỉ giữ tiếng bàn phím / chuột, không lời
# dẫn và không nhạc nền.
# Chế độ khoa học "full" mặc định dùng lời dẫn có sẵn trong video Seedance;
# tắt đi thì chuyển sang TTS bên ngoài.
KEPU_SEEDANCE_NATIVE_AUDIO=true
# Chỉ khi NATIVE_AUDIO=false: Seedance chỉ tạo âm thanh thao tác + TTS ở hậu kỳ (khuyến nghị để true)
KEPU_SEEDANCE_SFX_AUDIO=true
# Model id TTS phía trên (danh mục TokenFree hiện dùng qwen-tts; seed-tts-2.0 đã ngừng)
MODEL_AUDIO=qwen-tts-2025-05-22

# Tổng hợp giọng nói Doubao (openspeech, dùng khoá khác với khoá TokenFree).
# S_ nhân bản giọng nói vẫn đi qua khoá này; chưa điền thì TokenFree dùng /audio/speech
# API Key của console bản mới (tên biến tương ứng trong dự án ai-manju là SPEECH_API_KEY)
# VOLC_TTS_API_KEY=
# Console bản cũ (tuỳ chọn, dùng làm dự phòng)
# VOLC_TTS_APP_ID=
# VOLC_TTS_ACCESS_KEY=
# VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# VOLC_TTS_SPEAKER=zh_female_cancan_uranus_bigtts
# Thiết kế giọng nói nhân vật (cần mua slot S_ trên console): https://docs.volcengine.com/docs/6561/2277844
# VOLC_TTS_VOICE_DESIGN_SPEAKER_IDS=S_xxx,S_yyy
# VOLC_TTS_VOICE_DESIGN_URL=https://openspeech.bytedance.com/api/v3/tts/voice_design

# Đối chiếu định mức dùng từ phía thượng nguồn cũng đi qua TokenFree New API
# (dùng chung khoá với trang「Mô hình」), không cần AK/SK của console Ark
# BILLING_USD_CNY=7.0

ARK_IMAGE_SIZE=2k
ARK_VIDEO_RESOLUTION=480p
ARK_VIDEO_RATIO=16:9
ARK_VIDEO_POLL_INTERVAL=8
ARK_VIDEO_POLL_TIMEOUT=900
PIPELINE_IMAGE_CONCURRENCY=3
TOKENFREE_IMAGE_CONCURRENCY=1
PIPELINE_VIDEO_CONCURRENCY=10
PIPELINE_AUDIO_CONCURRENCY=4

# Aliyun OSS (upload phim cuối / ảnh storyboard; FFmpeg vẫn dùng tệp cục bộ.
# Cách đẩy frontend dist lên OSS: deploy/scripts/upload_oss_web.py)
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-bucket
OSS_FOLDER=kepu
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
# OSS_PUBLIC_BASE=https://cdn.example.com
